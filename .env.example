# Conexión a PostgreSQL (mismo servidor que gianduia360-bbdd, esquema/rol aislado)
# Servidor: Google Cloud SQL. Descargar el certificado de la CA del servidor desde
# la consola (instancia -> Connections -> Security) y guardarlo en
# malaga-soft/certs/server-ca.pem (ignorado por git). Correr los comandos que tocan
# la base con NODE_EXTRA_CA_CERTS="$(pwd)/certs/server-ca.pem" para que se confíe.
PGHOST=
PGPORT=5432
PGDATABASE=gianduia360-bbdd
PGUSER=malaga_app
PGPASSWORD=
PGSSLMODE=require
# Ruta al certificado de la CA si el servidor usa TLS autofirmado (no dejar vacío en ese caso;
# nunca desactivar la verificación de certificado en el código)
PGSSLROOTCERT=
# Alternativa a PGSSLROOTCERT para entornos sin filesystem persistente (ej. Vercel):
# el CONTENIDO del certificado (certs/server-ca.pem) pegado directo acá, no una ruta.
# Si está seteada, src/lib/db.ts la usa en vez de depender de NODE_EXTRA_CA_CERTS.
# Dejar vacía en desarrollo local (seguís usando NODE_EXTRA_CA_CERTS como siempre).
PGSSLROOTCERT_CONTENT=
PG_SCHEMA=malaga

# Usado directamente por node-pg-migrate. uselibpqcompat=true es necesario en Cloud SQL:
# el certificado del servidor no incluye la IP pública como altname, así que la
# verificación estricta de hostname (sslmode=require tratado como verify-full) falla
# sin este flag. La cadena de certificado se sigue validando contra la CA igual.
DATABASE_URL=postgres://malaga_app:REEMPLAZAR@HOST:5432/gianduia360-bbdd?uselibpqcompat=true&sslmode=require
